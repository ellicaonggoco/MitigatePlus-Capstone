{
  "expo": {
    "name": "MitigatePlus",
    "slug": "mitigateplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/mitigateplus-logoonly.png",
    "userInterfaceStyle": "light",
    "jsEngine": "jsc",
    "splash": {
      "image": "./src/assets/images/mitigatepluswholelogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.ellicaonggoco.mitigateplus",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MitigatePlus uses your location to place hazard reports and show nearby hazards.",
        "NSCameraUsageDescription": "MitigatePlus uses the camera so you can attach hazard evidence to reports.",
        "NSPhotoLibraryUsageDescription": "MitigatePlus uses your photo library so you can attach hazard evidence to reports."
      }
    },
    "android": {
      "package": "com.ellicaonggoco.mitigateplus",
      "versionCode": 4,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/mitigateplus-logoonly.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./src/assets/images/mitigateplus-logoonly.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": "36cdafbb-a050-43a8-8129-328c567602bf"
      }
    }
  }
}
